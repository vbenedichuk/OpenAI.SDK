<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Version>2.0.0</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>VB.$(AssemblyName)</PackageId>
    <Title>An integration library for OpenAi SDK</Title>
    <Authors>Vyacheslav Benedihuk</Authors>
    <Product>VB.$(AssemblyName)</Product>
    <Description>Open AI integration api wrapper for .net</Description>
    <Copyright>(c) 2022-2023 by Vyacheslav Benedichuk</Copyright>
    <PackageProjectUrl>https://github.com/vbenedichuk/OpenAI.SDK</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/vbenedichuk</RepositoryUrl>
    <RepositoryType>https://github.com/vbenedichuk/OpenAI.SDK</RepositoryType>
    <PackageTags>openai sdk</PackageTags>
    <PackageReleaseNotes>2.0.0: CancellationToken support on every API; obsolete overloads without a token. Modern Chat DTOs (tools, structured output, multimodal content, max_completion_tokens). Configurable Timeout and named HttpClient. Input validation with clear exceptions. Robust HTTP handling: empty/204 bodies, URL escaping, JSON failures wrapped in OpenAiApiException, ConfigureAwait(false). OpenAiApiException exposes RequestUri, ResponseHeaders and RetryAfter. Image model selection for generation and editing. Breaking: CreateImageEditAsync gained a model parameter, ChatMessage.Content and ApiChatCompletionRequest.Stop accept objects.</PackageReleaseNotes>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="7.0.0" />
    <PackageReference Include="System.Net.Http.Json" Version="7.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

</Project>
